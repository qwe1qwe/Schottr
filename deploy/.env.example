# Für Docker Compose: kopieren nach .env und Passwörter ändern
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-auch-aendern
SCHOTTR_PORT=3000
SCHOTTR_ALLOW_REGISTRATION=false

# Für den Betrieb ohne Docker (npm start) zusätzlich:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=schottr
# DB_USER=schottr
# oder alles in einem: DATABASE_URL=mysql://schottr:passwort@127.0.0.1:3306/schottr
# SCHOTTR_SECURE_COOKIES=auto
# SCHOTTR_SESSION_DAYS=14

# Image-Version (latest = Stand von main, oder z. B. 1.0.0)
# SCHOTTR_TAG=latest
